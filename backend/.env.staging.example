# TalentLens Staging Environment Configuration Template
PROJECT_NAME="TalentLens Staging"
API_V1_STR="/api/v1"
ENVIRONMENT="staging"

# Security (MUST replace with unique cryptographically random secret in staging)
SECRET_KEY="REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET_FOR_STAGING"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Staging PostgreSQL Database
DATABASE_URL="postgresql+asyncpg://talentlens_staging_user:STRONG_STAGING_PASSWORD@staging-db-host:5432/talentlens_staging"
TEST_DATABASE_URL="postgresql+asyncpg://talentlens_staging_user:STRONG_STAGING_PASSWORD@staging-db-host:5432/talentlens_staging_test"

# Staging CORS Allowlist
CORS_ORIGINS=["https://staging.talentlens.internal","https://staging-app.talentlens.internal"]

# Staging Storage
UPLOAD_DIR="/var/data/talentlens/resumes"
MAX_UPLOAD_SIZE_BYTES=5242880

# AI / Ollama Inference Microservice
OLLAMA_BASE_URL="http://ollama-service:11434"
OLLAMA_PRIMARY_MODEL="qwen3:4b"
OLLAMA_FALLBACK_MODEL="llama3.2:1b"
OLLAMA_EMBED_MODEL="nomic-embed-text:latest"
