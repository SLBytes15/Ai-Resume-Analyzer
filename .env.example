# TalentLens Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# Environment Mode: development | staging | production
ENVIRONMENT=development

# Application Info
PROJECT_NAME="TalentLens"
API_V1_STR="/api/v1"

# Security & Authentication
# CRITICAL: In production, generate a secure random 32+ character key: openssl rand -hex 32
SECRET_KEY="talentlens-mvp-super-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 17 asyncpg)
DATABASE_URL="postgresql+asyncpg://saranshop@/talentlens_mvp?host=/tmp"
TEST_DATABASE_URL="postgresql+asyncpg://saranshop@/talentlens_test?host=/tmp"

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# File Storage Configuration
UPLOAD_DIR="data/resumes"
MAX_UPLOAD_SIZE_BYTES=5242880

# Local Ollama AI Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_PRIMARY_MODEL="qwen3:4b"
OLLAMA_FALLBACK_MODEL="llama3.2:1b"
OLLAMA_TIMEOUT_SECONDS=60.0

# API Documentation (Set to false in production)
DOCS_ENABLED=true

# Rate Limiting & Resource Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=20

# Observability
LOG_LEVEL="INFO"
LOG_FORMAT="json"
